# NexusRAG environment configuration
# Copy this file to .env and fill in values. Never commit .env.

# Application
APP_NAME=NexusRAG
APP_ENV=development
LOG_LEVEL=INFO

# Storage
DATA_DIR=data
MAX_UPLOAD_MB=25

# LLM (unused in Phase 1 — required from Phase 4)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Embeddings (unused in Phase 1 — required from Phase 2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
